{
  "custom_id": "<scene_token>__<sample_token>",
  "method": "POST",
  "url": "/v1/chat/completions",
  "body": {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": [
          {"type": "text", "text": "<expanded structured ODD prompt>"},
          {"type": "image_url", "image_url": {"url": "<local JPEG encoded as a data URL>"}}
        ]
      }
    ]
  }
}
